# ---------------------------------------------------------------
# Copier ce fichier en `.env` à la racine : cp .env.example .env
# Ne jamais committer le fichier .env.
# ---------------------------------------------------------------

# Base de données PostgreSQL (docker compose : `pnpm db:up`)
DATABASE_URL="postgresql://quercy:quercy@localhost:5432/quercy?schema=public"

# Redis (cache, files d'attente BullMQ)
REDIS_URL="redis://localhost:6379"

# URL publique de l'application web
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentification (Better Auth). En production : `openssl rand -base64 32`.
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"

# Connexion Google (facultatif : le bouton n'apparaît que si les deux valeurs sont renseignées)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Connexion Microsoft 365 / Entra ID (facultatif)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Emails transactionnels (Resend). Sans clé, les emails sont écrits dans le journal du serveur.
RESEND_API_KEY=""
EMAIL_FROM="Quercy <no-reply@quercy.app>"

# Boîte de réception de développement (/api/dev/mailbox) — uniquement sans Resend.
# NE JAMAIS activer en production.
ENABLE_DEV_MAILBOX="true"

# Assistant IA (Claude). Sans clé, le panneau de l'assistant indique qu'il n'est pas configuré.
ANTHROPIC_API_KEY=""
# Modèle et niveau d'effort (low, medium, high, xhigh, max).
AI_MODEL="claude-opus-5"
AI_EFFORT="medium"

# Chiffrement des secrets stockés (clés Stripe des entreprises pour le paiement des factures).
# 32 octets en base64 (openssl rand -base64 32). Vide : dérivée de BETTER_AUTH_SECRET.
ENCRYPTION_KEY=""

# Limitation de débit des connexions (« off » réservé aux tests E2E, jamais en production).
AUTH_RATE_LIMIT="on"

# Paiement Stripe (facultatif en développement : sans clé, les offres restent consultables).
# `pnpm stripe:setup` crée les produits et prix en mode test et affiche les valeurs à coller ici.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTH=""
STRIPE_PRICE_PRO_YEAR=""
STRIPE_PRICE_BUSINESS_MONTH=""
STRIPE_PRICE_BUSINESS_YEAR=""
SALES_EMAIL="commercial@quercy.app"

# Stockage des fichiers : « local » (dossier .storage, développement) ou « s3 »
# (Amazon S3, Cloudflare R2, Scaleway, MinIO…).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Domaines supplémentaires autorisés à se connecter (séparés par des virgules), ex. un domaine personnalisé.
TRUSTED_ORIGINS=""
