# ---------------------------------------------------------------
# Copier ce fichier en `.env` à la racine : cp .env.example .env
# Ne jamais committer le fichier .env.
# ---------------------------------------------------------------

# Base de données PostgreSQL (docker compose : `pnpm db:up`)
DATABASE_URL="postgresql://quercy:quercy@localhost:5432/quercy?schema=public"

# Redis (cache, files d'attente BullMQ)
REDIS_URL="redis://localhost:6379"

# URL publique de l'application web
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentification (Better Auth). En production : `openssl rand -base64 32`.
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"

# Connexion Google (facultatif : le bouton n'apparaît que si les deux valeurs sont renseignées)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Connexion Microsoft 365 / Entra ID (facultatif)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Emails transactionnels (Resend). Sans clé, les emails sont écrits dans le journal du serveur.
RESEND_API_KEY=""
EMAIL_FROM="Quercy <no-reply@quercy.app>"

# Boîte de réception de développement (/api/dev/mailbox) — uniquement sans Resend.
# NE JAMAIS activer en production.
ENABLE_DEV_MAILBOX="true"

# Limitation de débit des connexions (« off » réservé aux tests E2E, jamais en production).
AUTH_RATE_LIMIT="on"
