{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits des fenêtres Quercy : seule l'adresse du serveur Quercy peut appeler l'application.",
  "windows": ["*"],
  "remote": {
    "urls": ["https://app.quercy.fr/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "notification:default",
    "opener:default"
  ]
}
