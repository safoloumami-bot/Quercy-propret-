{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quercy",
  "version": "0.10.0",
  "identifier": "app.quercy.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb"],
    "category": "Business",
    "shortDescription": "Logiciel de gestion tout-en-un",
    "longDescription": "Quercy : CRM, ventes et facturation, achats, stocks, projets, agenda, support, RH, trésorerie et documents.",
    "copyright": "© Quercy",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {}
}
