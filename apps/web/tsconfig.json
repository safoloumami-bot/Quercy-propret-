{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve"
  },
  "include": ["next-env.d.ts", "src", "e2e", "scripts", ".next/types/**/*.ts", "*.ts"],
  "exclude": ["node_modules"]
}
