}

model Ticket {
  id             String    @id @default(cuid())
  organizationId String
  subject        String
  status         String    @default("new")
  priority       String    @default("normal")
  channel        String?
  dueDate        DateTime?
  resolvedAt     DateTime?
  description    String?
  companyId      String?
  contactId      String?
  ownerId        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company      Company?     @relation("TicketCompany", fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation("TicketContact", fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, deletedAt])
  @@map("ticket")
}

model Employee {
  id               String    @id @default(cuid())
  organizationId   String
  firstName        String
  lastName         String
  jobTitle         String?
  department       String?
  email            String?
  phone            String?
  contractType     String?
  status           String    @default("active")
  startDate        DateTime?
  endDate          DateTime?
  grossSalaryCents Int       @default(0)
  ownerId          String?
  tags             String[]  @default([])
  customFields     Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("EmployeeOwner", fields: [ownerId], references: [id], onDelete: SetNull)

