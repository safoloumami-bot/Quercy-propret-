// ─────────────────────────── Phase 9 : automatisations et intégrations ───────────────────────────

/// Règle « quand… si… alors… » sur une entité.
model Automation {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  entity         String
  /// created, updated, deleted
  trigger        String
  conditions     Json      @default("{}")
  actions        Json      @default("[]")
  active         Boolean   @default(true)
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  lastError      String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entity, trigger, active])
  @@map("automation")
}

/// Clé d'API publique (seule l'empreinte est conservée).
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// Début de la clé, affiché pour la reconnaître.
  prefix         String
  hash           String    @unique
  /// read, write
  scope          String    @default("read")
  /// La clé agit avec les droits de cette personne.
  userId         String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ApiKeyUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_key")
}

/// Webhook sortant : les évènements choisis sont envoyés signés (HMAC SHA-256).
model Webhook {
  id              String    @id @default(cuid())
  organizationId  String
  url             String
  /// Secret de signature, chiffré.
  secret          String
  events          String[]  @default([])
  active          Boolean   @default(true)
  lastStatus      Int?
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, active])
  @@map("webhook")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  /// pending, delivered, failed
  status     String   @default("pending")
  statusCode Int?
  error      String?
  attempts   Int      @default(0)
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@map("webhook_delivery")
}

// ─────────────────────────── Nettoyage & interventions ───────────────────────────

/// Site client : lieu d'intervention (adresse, accès, consignes).
model Site {
  id             String    @id @default(cuid())
  organizationId String
  /// Code interne du site (C01, B01…), unique dans l'entreprise.
  code           String?
  name           String
  /// Site parent : une cage d'escalier dans sa résidence, un bâtiment dans son ensemble.
  parentId       String?
  companyId      String?
  address        String?
  postalCode     String?
  city           String?
  surfaceM2      Float?
  openingHours   String?
  accessCode     String?
  keys           String?
  instructions   String?
  status         String    @default("active")
  ownerId        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?               @relation("SiteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company       Company?            @relation("SiteCompany", fields: [companyId], references: [id], onDelete: SetNull)
  contracts     CleaningContract[]  @relation("CleaningContractSite")
  interventions Intervention[]      @relation("InterventionSite")
  inspections   Inspection[]        @relation("InspectionSite")
  serviceLines  ServiceLine[]
  closures      SiteClosure[]
  proofs        InterventionProof[]
  anomalies     Anomaly[]
  parent        Site?               @relation("SiteParent", fields: [parentId], references: [id], onDelete: NoAction)
  children      Site[]              @relation("SiteParent")
  infos         SiteInfo[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("site")
}

/// Contrat d'entretien récurrent : jours, horaire et durée ; génère les interventions.
model CleaningContract {
  id                String    @id @default(cuid())
  organizationId    String
  name              String
  companyId         String?
  siteId            String
  status            String    @default("active")
  weekdays          String[]  @default([])
  startTime         String?
  durationMinutes   Int?
  agentId           String?
  monthlyPriceCents Int?
  startDate         DateTime?
  endDate           DateTime?
  generatedUntil    DateTime?
  description       String?
  ownerId           String?
  tags              String[]  @default([])
  customFields      Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("CleaningContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent         User?          @relation("CleaningContractAgent", fields: [agentId], references: [id], onDelete: SetNull)
  company       Company?       @relation("CleaningContractCompany", fields: [companyId], references: [id], onDelete: SetNull)
  site          Site           @relation("CleaningContractSite", fields: [siteId], references: [id], onDelete: Cascade)
  interventions Intervention[] @relation("InterventionContract")
  serviceLines  ServiceLine[]

  @@index([organizationId, deletedAt])
  @@map("cleaning_contract")
}

/// Intervention planifiée chez un client : agent (ownerId), horaire, pointage et signature.
model Intervention {
  id                  String    @id @default(cuid())
  organizationId      String
  title               String
  siteId              String?
  contractId          String?
  companyId           String?
  ownerId             String?
  date                DateTime
  startTime           String?
  durationMinutes     Int?
  status              String    @default("planned")
  checkInAt           DateTime?
  checkOutAt          DateTime?
  workedMinutes       Int?
  signatureUrl        String?
  signedBy            String?
  photoUrl            String?
  notes               String?
  /// Numéro du bon d'intervention, attribué à la clôture depuis l'application terrain.
  reportNumber        String?
  /// Prestation contractuelle, série de récurrence et version de règle qui l'ont générée.
  serviceLineId       String?
  seriesId            String?
  ruleVersionId       String?
  /// Clé d'unicité du créneau (série + date) : une intervention n'est jamais générée deux fois.
  slotKey             String?
  /// Date prévue à l'origine, gardée quand l'intervention est déplacée.
  originalPlannedDate DateTime?
  /// Intervenant prévu = ownerId ; remplaçant affecté ; intervenant ayant réellement exécuté.
  replacementAgentId  String?
  actualAgentId       String?
  /// Notes saisies sur le terrain (distinctes du compte rendu).
  fieldNotes          String?
  /// État propre à l'application terrain : grille choisie, coordonnées saisies du client,
  /// pointages hors réseau, clôture. Le relevé lui-même (points de contrôle, consommables,
  /// photos, journal) est rangé dans ses propres tables.
  fieldData           Json?
  tags                String[]  @default([])
  customFields        Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?                    @relation("InterventionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  site             Site?                    @relation("InterventionSite", fields: [siteId], references: [id], onDelete: SetNull)
  contract         CleaningContract?        @relation("InterventionContract", fields: [contractId], references: [id], onDelete: SetNull)
  company          Company?                 @relation("InterventionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  serviceLine      ServiceLine?             @relation(fields: [serviceLineId], references: [id], onDelete: NoAction)
  series           RecurrenceSeries?        @relation(fields: [seriesId], references: [id], onDelete: NoAction)
  ruleVersion      RecurrenceRuleVersion?   @relation(fields: [ruleVersionId], references: [id], onDelete: NoAction)
  replacementAgent User?                    @relation("InterventionReplacement", fields: [replacementAgentId], references: [id], onDelete: SetNull)
  actualAgent      User?                    @relation("InterventionActual", fields: [actualAgentId], references: [id], onDelete: SetNull)
  events           InterventionEvent[]
  proofs           InterventionProof[]
  anomalies        Anomaly[]
  tasks            InterventionTask[]
  consumables      InterventionConsumable[]

  @@unique([organizationId, slotKey])
  @@index([contractId, date])
  @@index([organizationId, deletedAt, date])
  @@index([organizationId, ownerId, date])
  @@map("intervention")
}

/// Contrôle qualité d'un site : grille notée, résultat et photo.
model Inspection {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  siteId         String?
  date           DateTime
  floors         Boolean   @default(false)
  sanitary       Boolean   @default(false)
  dusting        Boolean   @default(false)
  windows        Boolean   @default(false)
  bins           Boolean   @default(false)
  score          Int?
  result         String?
  photoUrl       String?
  comments       String?
  ownerId        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("InspectionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  site         Site?        @relation("InspectionSite", fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId, deletedAt])
  @@map("inspection")
}

/// Accès à l'application terrain : identifiant et code à 6 chiffres d'un membre.
model FieldAccess {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Identifiant saisi sur le téléphone (minuscules, unique dans l'espace).
  code           String
  pinHash        String
  pinSalt        String
  /// patron (responsable : agents et chantiers) ou agent.
  role           String   @default("agent")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@unique([organizationId, userId])
  @@map("field_access")
}

/// Prestation contractuelle : ce qui est vendu sur un site dans un contrat (escalier, hall, vitres…).
/// Sa fréquence vit dans ses séries de récurrence, jamais dans le site.
model ServiceLine {
  id              String    @id @default(cuid())
  organizationId  String
  contractId      String
  siteId          String
  name            String
  /// Activité (cage, vitre, bureau, ponctuel…) : libre, propre à chaque métier.
  activity        String?
  description     String?
  plannedAgentId  String?
  startTime       String?
  durationMinutes Int?
  unitPriceCents  Int?
  /// Référence d'import (ex. « v12:C01 ») : un second import ne crée pas de doublon.
  externalRef     String?
  /// active ou archived (jamais supprimée : l'historique en dépend).
  status          String    @default("active")
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract      CleaningContract   @relation(fields: [contractId], references: [id], onDelete: NoAction)
  site          Site               @relation(fields: [siteId], references: [id], onDelete: NoAction)
  plannedAgent  User?              @relation("ServiceLineAgent", fields: [plannedAgentId], references: [id], onDelete: SetNull)
  series        RecurrenceSeries[]
  interventions Intervention[]

  @@unique([organizationId, externalRef])
  @@index([organizationId, contractId])
  @@index([organizationId, siteId])
  @@map("service_line")
}

/// Série de récurrence d'une prestation. Proposée (import), puis validée : elle génère alors
/// les interventions futures selon la version de règle en vigueur.
model RecurrenceSeries {
  id              String    @id @default(cuid())
  organizationId  String
  serviceLineId   String
  /// proposed, active, paused, ended
  status          String    @default("proposed")
  /// Jour férié : keep (maintenir), skip (ignorer), before (veille ouvrée), after (lendemain ouvré).
  holidayPolicy   String    @default("keep")
  timezone        String    @default("Europe/Paris")
  /// Calendrier des jours fériés : fr, fr-alsace-moselle.
  holidayCalendar String    @default("fr")
  /// Origine : manual, import_v12…
  source          String    @default("manual")
  generatedUntil  DateTime?
  validatedById   String?
  validatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceLine   ServiceLine             @relation(fields: [serviceLineId], references: [id], onDelete: NoAction)
  validatedBy   User?                   @relation("SeriesValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  versions      RecurrenceRuleVersion[]
  interventions Intervention[]

  @@index([organizationId, status])
  @@map("recurrence_series")
}

/// Version d'une règle de récurrence, en vigueur à partir d'une date. Une fréquence qui change
/// crée une nouvelle version : les versions passées ne sont jamais modifiées.
model RecurrenceRuleVersion {
  id              String    @id @default(cuid())
  organizationId  String
  seriesId        String
  version         Int
  /// Jour d'effet (inclus) et jour de fin (inclus), dans le fuseau de la série.
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  /// Règle (voir recurrenceRuleSchema dans @quercy/core).
  rule            Json
  startTime       String?
  durationMinutes Int?
  plannedAgentId  String?
  note            String?
  createdById     String?
  createdAt       DateTime  @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series        RecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: NoAction)
  plannedAgent  User?            @relation("RuleVersionAgent", fields: [plannedAgentId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("RuleVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  interventions Intervention[]

  @@unique([seriesId, version])
  @@index([organizationId, seriesId])
  @@map("recurrence_rule_version")
}

/// Fermeture d'un site (vacances, travaux) : aucun passage n'est généré sur la période.
model SiteClosure {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: NoAction)

  @@index([organizationId, siteId])
  @@map("site_closure")
}

/// Journal fin d'une intervention (prévue, démarrée, photo, anomalie, terminée…) : audit,
/// statistiques et, plus tard, IA.
model InterventionEvent {
  id             String   @id @default(cuid())
  organizationId String
  interventionId String
  userId         String?
  type           String
  at             DateTime @default(now())
  metadata       Json     @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: NoAction)
  user         User?        @relation("InterventionEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([interventionId, at])
  @@index([organizationId, type, at])
  @@map("intervention_event")
}

/// Photo ou preuve d'une intervention (avant, après, feuille de passage, signature…).
model InterventionProof {
  id             String   @id @default(cuid())
  organizationId String
  interventionId String
  siteId         String?
  /// photo_before, photo_after, photo, passage_sheet, signature, document
  type           String
  fileId         String?
  /// Zone ou pièce concernée (hall, escalier, sanitaires…).
  area           String?
  caption        String?
  /// Identifiant donné par le téléphone (renvoi hors réseau sans doublon).
  clientRef      String?
  authorId       String?
  takenAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: NoAction)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: NoAction)
  file         StoredFile?  @relation(fields: [fileId], references: [id], onDelete: NoAction)
  author       User?        @relation("ProofAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([interventionId, clientRef])
  @@index([organizationId, interventionId])
  @@map("intervention_proof")
}

/// Anomalie signalée sur un site (éclairage, fuite, encombrants…). Elle part au chef et au
/// patron, jamais au client : seule une anomalie validée peut figurer dans un rapport client.
model Anomaly {
  id              String    @id @default(cuid())
  organizationId  String
  siteId          String?
  interventionId  String?
  type            String
  location        String?
  comment         String?
  photoFileId     String?
  /// low, normal, high, critical
  severity        String    @default("normal")
  /// reported, validated, rejected, in_progress, resolved
  status          String    @default("reported")
  /// agent, system, inspection, client
  source          String    @default("agent")
  reportedById    String?
  reportedAt      DateTime  @default(now())
  validatedById   String?
  validatedAt     DateTime?
  resolution      String?
  resolvedById    String?
  resolvedAt      DateTime?
  /// Peut apparaître dans un rapport client (seulement après validation).
  visibleToClient Boolean   @default(false)
  /// Clé anti-doublon : anomalie automatique (`duree:<intervention>`…) ou renvoi hors réseau.
  dedupeKey       String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?         @relation(fields: [siteId], references: [id], onDelete: NoAction)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: NoAction)
  photo        StoredFile?   @relation(fields: [photoFileId], references: [id], onDelete: NoAction)
  reportedBy   User?         @relation("AnomalyReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  validatedBy  User?         @relation("AnomalyValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("AnomalyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@index([organizationId, siteId])
  @@map("anomaly")
}

/// Point de contrôle d'une intervention (pièce ou zone, élément), coché sur le terrain.
model InterventionTask {
  id             String    @id @default(cuid())
  organizationId String
  interventionId String
  /// Pièce ou zone (hall, escalier, sanitaires…).
  area           String
  label          String
  critical       Boolean   @default(false)
  done           Boolean   @default(false)
  doneAt         DateTime?
  doneById       String?
  /// Motif ou réserve quand le point n'est pas fait.
  reason         String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: NoAction)
  doneBy       User?        @relation("InterventionTaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([interventionId, sortOrder])
  @@index([organizationId, interventionId])
  @@map("intervention_task")
}

/// Consommable posé pendant une intervention (sacs, recharges, papier…).
model InterventionConsumable {
  id             String   @id @default(cuid())
  organizationId String
  interventionId String
  label          String
  unit           String?
  quantity       Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: NoAction)

  @@unique([interventionId, sortOrder])
  @@index([organizationId, interventionId])
  @@map("intervention_consumable")
}

/// Information de la fiche d'un site (accès, consignes, produits, risques…), avec sa
/// visibilité : chaque agent ne voit que ce qui le concerne.
model SiteInfo {
  id             String    @id @default(cuid())
  organizationId String
  siteId         String
  /// access, keys, instructions, surfaces, products, equipment, safety, proof, contact, team, other
  category       String    @default("other")
  label          String
  content        String
  /// site_agents (agents du site), agent (un agent précis), managers (responsables seulement)
  visibility     String    @default("site_agents")
  agentId        String?
  sortOrder      Int       @default(0)
  createdById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: NoAction)
  agent        User?        @relation("SiteInfoAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("SiteInfoCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, siteId])
  @@map("site_info")
}
